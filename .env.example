# =========================================================
# LangGraph Playground — environment template
# Copy this file to `.env` and fill in the values you need.
# =========================================================

# --- Provider switch (read by shared/llm/base.py) ---
# Set to "anthropic", "openai", "google", or "local". The whole
# curriculum picks up the change with no code edits.
LLM_PROVIDER=anthropic

# --- Model overrides (optional) ---
# Leave blank to use the adapter's default.
LLM_MODEL=

# --- Provider API keys ---
# You only need the key for the provider you selected above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Bring your own VLM (provider "local") ---
# Any OpenAI-compatible server: vLLM / Ollama / LM Studio / TGI.
# Used by the VLM comparison harness (projects/vlm_extraction_harness/compare_vlms.py).
LOCAL_VLM_BASE_URL=          # e.g. http://localhost:8000/v1
LOCAL_VLM_MODEL=             # e.g. Qwen/Qwen2.5-VL-7B-Instruct
LOCAL_API_KEY=               # any token your server accepts (e.g. EMPTY)

# --- Observability (optional but recommended) ---
# Enables tracing of every LCEL + LangGraph run in LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-playground

# --- Web search (used by lesson 05 + research_assistant capstone) ---
TAVILY_API_KEY=

# --- rag_qa_api capstone only (Postgres checkpointer) ---
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/langgraph
